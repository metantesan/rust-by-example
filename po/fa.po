msgstr "\"// جمع اعداد صحیح\\n\""
#: src/primitives/literals.md:25
msgid "\"1 + 2 = {}\""
msgstr "\"\"1 + 2 = {}\"\""
#: src/primitives/literals.md:27
msgid "// Integer subtraction\n"
msgstr "\"// تفریق اعداد صحیح\\n\""
