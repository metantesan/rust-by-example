msgid "\"called `deeply::nested::function()`\""
msgstr "\"فراخوانده شد `deeply::nested::function()`\""
#: src/mod/use.md:37
msgid "// Easier access to `deeply::nested::function`\n"
msgstr "// دسترسی آسان‌تر به `deeply::nested::function`\n"
#: src/mod/use.md:40
msgid "\"Entering block\""
msgstr "\"ورود به بلوک\""
#: src/mod/use.md:42
msgid ""
