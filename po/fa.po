msgstr "\"\"true AND false is {}\"\""
#: src/primitives/literals.md:36
msgid "\"true OR false is {}\""
msgstr "\"\"true OR false is {}\"\""
#: src/primitives/literals.md:37
msgid "\"NOT true is {}\""
msgstr "\"\"NOT true is {}\"\""
