msgstr "\"// `_box3` در اینجا نابود می‌شود و حافظه آزاد می‌شود\n"
"\""
#: src/scope/raii.md:32
msgid ""
"// Creating lots of boxes just for fun\n"
"    // There's no need to manually free memory!\n"
msgstr "\"// ساختن جعبه‌های زیاد فقط برای تفریح\n"
"\"\n"
"\"    // نیازی به آزادسازی دستی حافظه نیست!\n"
"\""
