msgstr "\"فراخوانده شد `my::indirect_access()`، که\\n> \""
#: src/mod/split.md:63
msgid "In `my/nested.rs`:"
msgstr "در `my/nested.rs`:"
#: src/mod/split.md:67
msgid "\"called `my::nested::function()`\""
msgstr "\"فراخوانده شد `my::nested::function()`\""
#: src/mod/split.md:72
msgid "\"called `my::nested::private_function()`\""
msgstr "\"فراخوانده شد `my::nested::private_function()`\""
